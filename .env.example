# Copy this file to .env and fill in your key.
# Without a key, Agni runs in demo mode with realistic sample data.
ANTHROPIC_API_KEY=

# Optional settings
# AGNI_MODEL=claude-opus-5-5
# AGNI_MAX_PARALLEL=8       # how many twins react at the same time
# AGNI_DEMO=1               # force demo mode even with a key
